# Local development settings. Copy to .env (never commit .env).

# Default branding for a fresh install. Each coach changes these at deploy time
# (CloudFormation parameter "AppName") and later in the admin setup wizard.
APP_NAME="Racket Club"
DEFAULT_LOCALE=en
TIMEZONE=Australia/Sydney
CURRENCY=AUD

# Local services
# AWS Emulator on https://127.0.0.1:9297 (docs/testing.md). Don't set AWS_* variables here:
# `pnpm dev` and `pnpm test:int` run through `pnpm aws:env`, which sets the endpoint, the
# emulator's per-run keys and its certificate, and keeps real AWS credentials out.
# Fallback until every integration test passes on the emulator: DynamoDB Local (`pnpm db:up`).
# If port 8000 is taken, change both lines (docker compose reads DYNAMODB_PORT from this file).
DYNAMODB_PORT=8000
DYNAMODB_ENDPOINT=http://localhost:8000
# With TABLE_NAME set, the API keeps its data in that table in the emulator (the local server
# refuses any non-local endpoint). E2E tests clear it to use in-memory settings.
TABLE_NAME=racket-club-local
API_PORT=8787

# Local dev uses a mock sign-in page instead of Google. Never enable in AWS.
AUTH_MODE=mock
